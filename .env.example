# Copy to .env and fill in values. Do not commit .env with real passwords.

# MySQL / MariaDB connection string.
# Local XAMPP defaults: user `root`, empty password, port 3306.
# Create the database first: see README.md → "Database setup".
DATABASE_URL="mysql://root@127.0.0.1:3306/dipencil_panel"

# Docker Compose override (only used when running `docker compose up`):
# DATABASE_URL="mysql://panel:panel_password@db:3306/dipencil_panel"

# Public URL of the panel app. Use the deployed subdomain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP - Hostinger example: smtp.hostinger.com, port 465, SSL
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM=noreply@example.com

# App secret for sessions and auth.
AUTH_SECRET=
